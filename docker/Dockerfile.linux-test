# BravoGuard Linux proof image (test-only, never production).
# Base pinned to bookworm slim; tool versions follow tools-manifest.json.
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy \
    PATH="/root/.local/bin:/root/go/bin:/usr/local/go/bin:${PATH}"

RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates golang nodejs npm \
 && rm -rf /var/lib/apt/lists/* \
 && curl -LsSf https://astral.sh/uv/install.sh | sh

WORKDIR /app

COPY pyproject.toml uv.lock tools-manifest.json README.md ./
COPY src/ ./src/
RUN uv sync --frozen --all-extras

COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY rules/ ./rules/
COPY docker/ ./docker/

RUN for pkg in semgrep bandit guarddog pip-audit ruff; do uv tool install "$pkg" || echo "NOTE: uv tool install $pkg failed"; done \
 && (go install github.com/google/osv-scanner/v2/cmd/osv-scanner@latest \
      || echo "NOTE: osv-scanner go install failed; pip-audit fallback covers OSV") \
 && (go install github.com/gitleaks/betterleaks@latest \
     || go install github.com/zricethezav/gitleaks/v8@latest \
     || echo "NOTE: secrets go install failed (bookworm go 1.19 too old); lane degrades to not-installed") \
 && (go install github.com/opengrep/opengrep@v1.26.0 \
     || echo "NOTE: opengrep go install failed; semgrep primary covers SAST") \
 && (npm i -g oxlint@1.65.0 \
     || echo "NOTE: oxlint npm install failed; see docs/DOCKER_PROOF.md")

CMD ["bash", "docker/proof-linux.sh"]
